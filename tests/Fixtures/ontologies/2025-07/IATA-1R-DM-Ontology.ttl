@prefix : <https://onerecord.iata.org/ns/cargo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix codes: <https://onerecord.iata.org/ns/code-lists/> .
@base <https://onerecord.iata.org/ns/cargo#> .

# A miniature of IATA's cargo ontology: enough shape for the generator tests.
<https://onerecord.iata.org/ns/cargo> rdf:type owl:Ontology ;
    owl:versionIRI <https://onerecord.iata.org/ns/cargo/3.2> ;
    owl:versionInfo "3.2" .

:LogisticsObject rdf:type owl:Class ;
    rdfs:comment "Root of everything published under its own URI"@en ;
    rdfs:label "LogisticsObject"@en .

:PhysicalLogisticsObject rdf:type owl:Class ;
    rdfs:subClassOf :LogisticsObject .

:Piece rdf:type owl:Class ;
    rdfs:subClassOf :PhysicalLogisticsObject ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :grossWeight ;
                      owl:allValuesFrom :Value
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :grossWeight ;
                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :coload ;
                      owl:allValuesFrom xsd:boolean
                    ] ;
    rdfs:comment "Piece, a \"physical\" unit of cargo"@en ;
    rdfs:label "Piece"@en .

:Value rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty :numericalValue ;
                      owl:allValuesFrom xsd:double
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :unit ;
                      owl:allValuesFrom codes:MeasurementUnitCode
                    ] ;
    rdfs:comment """Unit
and value"""@en .

:EventTimeType rdf:type owl:Class .

:OldThing rdf:type owl:Class ;
    rdfs:subClassOf :LogisticsObject ;
    owl:deprecated "true"^^xsd:boolean .

:grossWeight rdf:type owl:ObjectProperty ;
    rdfs:range :Value ;
    rdfs:comment "Weight details"@en ;
    owl:comment "Domain :Piece"@en .

:unit rdf:type owl:ObjectProperty ;
    rdfs:range codes:MeasurementUnitCode ;
    owl:comment "Domain :Value"@en .

:numericalValue rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    owl:comment "Domain :Value"@en .

:coload rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    owl:comment "Domain :Piece"@en .

:goodsDescription rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Description of goods"@en ;
    owl:comment "Domain owl:Thing"@en .

:airlineCode rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:onDatatype xsd:string ;
                 owl:withRestrictions ( [ xsd:maxLength 2 ] )
               ] ;
    owl:comment "Domain :Piece"@en .

:legacyField rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    owl:comment "Domain :Piece"@en .

:ACTUAL rdf:type owl:NamedIndividual , :EventTimeType ;
    rdfs:comment "Used when a time is actual"@en .

codes:MeasurementUnitCode rdf:type owl:Class .
