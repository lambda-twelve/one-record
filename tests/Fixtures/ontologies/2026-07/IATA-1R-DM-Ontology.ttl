@prefix : <https://onerecord.iata.org/ns/cargo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix codes: <https://onerecord.iata.org/ns/code-lists/> .
@base <https://onerecord.iata.org/ns/cargo#> .

# The next edition of the miniature: one class and one property added, one
# property deprecated, one property removed, one class de-deprecated.
<https://onerecord.iata.org/ns/cargo> rdf:type owl:Ontology ;
    owl:versionIRI <https://onerecord.iata.org/ns/cargo/3.3> ;
    owl:versionInfo "3.3.0"@en .

:LogisticsObject rdf:type owl:Class .
:PhysicalLogisticsObject rdf:type owl:Class ; rdfs:subClassOf :LogisticsObject .

:Piece rdf:type owl:Class ;
    rdfs:subClassOf :PhysicalLogisticsObject ,
                    [ rdf:type owl:Restriction ; owl:onProperty :grossWeight ; owl:allValuesFrom :Value ] ,
                    [ rdf:type owl:Restriction ; owl:onProperty :coload ; owl:allValuesFrom xsd:boolean ] ,
                    [ rdf:type owl:Restriction ; owl:onProperty :otherIdentifiers ; owl:allValuesFrom xsd:string ] ;
    rdfs:comment "Piece, a \"physical\" unit of cargo"@en .

:Value rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :numericalValue ; owl:allValuesFrom xsd:double ] ,
                    [ rdf:type owl:Restriction ; owl:onProperty :unit ; owl:allValuesFrom codes:MeasurementUnitCode ] .

:EventTimeType rdf:type owl:Class .
:OldThing rdf:type owl:Class ; rdfs:subClassOf :LogisticsObject .

:StatusUpdateEvent rdf:type owl:Class ;
    rdfs:subClassOf :LogisticsObject ;
    rdfs:comment "New in this edition"@en .

:grossWeight rdf:type owl:ObjectProperty ; rdfs:range :Value ; rdfs:comment "Weight details"@en ; owl:comment "Domain :Piece"@en .
:unit rdf:type owl:ObjectProperty ; rdfs:range codes:MeasurementUnitCode ; owl:comment "Domain :Value"@en .
:numericalValue rdf:type owl:DatatypeProperty ; rdfs:range xsd:double ; owl:comment "Domain :Value"@en .
:coload rdf:type owl:DatatypeProperty ; rdfs:range xsd:boolean ; owl:comment "Domain :Piece"@en ; owl:deprecated "true"^^xsd:boolean .
:goodsDescription rdf:type owl:DatatypeProperty ; rdfs:range xsd:string ; owl:comment "Domain owl:Thing"@en .
:airlineCode rdf:type owl:DatatypeProperty ; rdfs:range xsd:string ; owl:comment "Domain :Piece"@en .
:otherIdentifiers rdf:type owl:DatatypeProperty ; rdfs:range xsd:string ; owl:comment "Domain :Piece"@en .

:ACTUAL rdf:type owl:NamedIndividual , :EventTimeType .

codes:MeasurementUnitCode rdf:type owl:Class .
