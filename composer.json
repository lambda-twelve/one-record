{
    "name": "lambda-twelve/one-record",
    "description": "IATA ONE Record for PHP: a framework-agnostic server (PSR-15) and client (PSR-18) for ONE Record API 2.2/2.3 and data model 3.2/3.3.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["iata", "one-record", "air-cargo", "json-ld", "logistics"],
    "homepage": "https://github.com/lambda-twelve/one-record",
    "authors": [
        {
            "name": "Nick Andriopoulos",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/lambda-twelve/one-record/issues",
        "source": "https://github.com/lambda-twelve/one-record",
        "docs": "https://lambda-twelve.github.io/one-record/"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LambdaTwelve\\OneRecord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LambdaTwelve\\OneRecord\\Tools\\": "tools/",
            "LambdaTwelve\\OneRecord\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "vocab": "php bin/generate-vocabulary"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
